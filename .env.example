# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# Web search (Startup, Hackathon, Research). Free tier at https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Required: sign-in (Auth.js). Every page except Home, About and /login needs it.
# AUTH_SECRET signs the session cookie. Generate one with: npx auth secret
AUTH_SECRET=
# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Callback URL: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: a free OpenRouter model to try first as the Auto judge ("Brainy's Take"),
# e.g. nvidia/nemotron-3-ultra-550b-a55b:free. The server key is free-only, so a
# paid model here is ignored. Leave blank for Brainy's own ranking.
JUDGE_MODEL=

# Optional: raises GitHub search from 10 to 30 requests/minute.
# Create a fine-grained token with no permissions at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional: how many model calls a day ALL visitors together may make on
# OPENROUTER_API_KEY (default 45; resets at midnight UTC). Every call counts,
# fallbacks included. Calls on a visitor's own key (Settings -> API keys) don't.
GLOBAL_DAILY_CALLS=

# Optional: cloud sync (Settings -> "Sync history across devices"). Created by
# Vercel Storage -> Neon. DATABASE_URL is the pooled URL the app uses;
# DATABASE_URL_UNPOOLED is the direct one migrations use (npm run db:migrate).
# Leave blank to run without sync.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional locally, REQUIRED for a public deploy: daily usage limits
# (5 free runs per user, 15 per IP, GLOBAL_DAILY_CALLS model calls in total, 50
# runs per user on their own key), plus the model list cache and model health.
# Leave blank to turn limits off.
# Free database at https://console.upstash.com -> Redis -> Create database,
# then copy the "REST URL" and "REST TOKEN" from its page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# If you add Upstash through Vercel's Storage tab instead, it creates
# KV_REST_API_URL / KV_REST_API_TOKEN. Those are used as a fallback when the
# UPSTASH_* vars are unset, so there's no need to rename them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
